<?xml version="1.0" encoding="UTF-8"?>
<!--
  paint.sky — draw, open pictures and save them in your files.
  The example of the files of a .sky app: sky.files.open() and sky.files.saveAs() show Skypane's own windows
  (the app sees only what you choose there), sky.files.read() and sky.files.write() work on those files only,
  <opens> offers the app in «Open with…» of Files, and sky.launch.file is the picture it was opened with.
  The tool, colour and size are remembered with sky.data.
-->
<sky-app id="net.skypane.paint" version="1.0.0" author="Skypane">

  <translations>
    <lang code="en" default="true"><![CDATA[{
      "name": "Paint",
      "description": "Draw, open your pictures and save them in your files.",
      "info": "Pencil, brush, eraser, lines, rectangles, ellipses and fill, with undo.\nOpen a picture from your files (or from Files › Open with…) and save it back, or save a new one where you like.\nPaint sees only the files you choose for it.",
      "file": "File", "edit": "Edit",
      "new": "New", "open": "Open…", "save": "Save", "saveAs": "Save as…", "newWindow": "New window",
      "undo": "Undo", "redo": "Redo", "clear": "Clear",
      "untitled": "Drawing", "drawingName": "Drawing.png",
      "pencil": "Pencil", "brush": "Brush", "eraser": "Eraser", "line": "Line", "rect": "Rectangle", "ellipse": "Ellipse", "fill": "Fill", "picker": "Pick a colour",
      "filled": "Filled shapes", "size": "Size", "colour": "Colour", "more": "Other colour",
      "saved": "Saved in «{name}».", "opened": "«{name}» opened.",
      "discard": "Leave the changes of this drawing?", "changed": "This picture was changed elsewhere after you opened it. Save over it?",
      "notPicture": "This file is not a picture Paint can open.", "readOnly": "This picture is read only for you: use «Save as…» to keep a copy.",
      "big": "This picture is big: it was made smaller to fit ({w} × {h})."
    }]]></lang>
    <lang code="it"><![CDATA[{
      "name": "Disegno",
      "description": "Disegna, apri le tue immagini e salvale tra i tuoi file.",
      "info": "Matita, pennello, gomma, linee, rettangoli, ellissi e riempimento, con annulla.\nApri un'immagine dai tuoi file (o da File › Apri con…) e salvala di nuovo, oppure salvane una nuova dove vuoi.\nDisegno vede solo i file che scegli tu.",
      "file": "File", "edit": "Modifica",
      "new": "Nuovo", "open": "Apri…", "save": "Salva", "saveAs": "Salva con nome…", "newWindow": "Nuova finestra",
      "undo": "Annulla", "redo": "Ripeti", "clear": "Cancella tutto",
      "untitled": "Disegno", "drawingName": "Disegno.png",
      "pencil": "Matita", "brush": "Pennello", "eraser": "Gomma", "line": "Linea", "rect": "Rettangolo", "ellipse": "Ellisse", "fill": "Riempimento", "picker": "Preleva un colore",
      "filled": "Forme piene", "size": "Dimensione", "colour": "Colore", "more": "Altro colore",
      "saved": "Salvato in «{name}».", "opened": "«{name}» aperto.",
      "discard": "Lasciare le modifiche di questo disegno?", "changed": "Questa immagine è stata cambiata altrove dopo che l'hai aperta. Salvare sopra?",
      "notPicture": "Questo file non è un'immagine che Disegno sa aprire.", "readOnly": "Per te questa immagine è in sola lettura: usa «Salva con nome…» per tenerne una copia.",
      "big": "Questa immagine è grande: è stata rimpicciolita ({w} × {h})."
    }]]></lang>
  </translations>

  <icon><![CDATA[<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><defs><linearGradient id="p" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffe0b2"/><stop offset="1" stop-color="#e8a85c"/></linearGradient><linearGradient id="h" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8d6e63"/><stop offset="1" stop-color="#4e342e"/></linearGradient></defs><path d="M24 5C12.4 5 4 13 4 23c0 9.6 8 17 17.5 17 3 0 4.5-1.6 4.5-3.6 0-2.6-2.4-3.2-2.4-5.4 0-2 1.6-3.2 3.8-3.2H33c6.5 0 11-4.2 11-10C44 10.6 35 5 24 5Z" fill="url(#p)" stroke="#b9773a" stroke-width="1.2"/><circle cx="14" cy="21" r="3.6" fill="#e53935"/><circle cx="20" cy="13" r="3.6" fill="#fdd835"/><circle cx="30" cy="12" r="3.6" fill="#43a047"/><circle cx="37" cy="19" r="3.6" fill="#1e88e5"/><circle cx="15" cy="31" r="3.6" fill="#8e24aa"/><path d="M47 25 32 40l-3.5 1 1-3.5L44.5 22.5Z" fill="url(#h)"/><path d="m29.5 37.5-1 3.5 3.5-1Z" fill="#263238"/><path d="M8 14C12 8 18 6 24 6" stroke="#fff" stroke-width="2" stroke-linecap="round" fill="none" opacity=".6"/></svg>]]></icon>

  <window width="860" height="600"/>

  <opens types=".png .jpg .jpeg .webp .gif .bmp image/png image/jpeg image/webp image/gif image/bmp"/>

  <menu>
    <menu label="file">
      <item label="new" action="new"/>
      <item label="open" action="open" shortcut="Ctrl+O"/>
      <separator/>
      <item label="save" action="save" shortcut="Ctrl+S"/>
      <item label="saveAs" action="saveAs" shortcut="Ctrl+Shift+S"/>
      <separator/>
      <item label="newWindow" action="" target="window"/>
    </menu>
    <menu label="edit">
      <item label="undo" action="undo" shortcut="Ctrl+Z"/>
      <item label="redo" action="redo" shortcut="Ctrl+Y"/>
      <separator/>
      <item label="clear" action="clear"/>
    </menu>
  </menu>

  <style><![CDATA[
    body { display: flex; flex-direction: column; overflow: hidden; user-select: none; -webkit-user-select: none; }
    .tools { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; padding: 6px 8px; scrollbar-width: none;
      background: var(--sky-surface); border-bottom: 1px solid var(--sky-border); }
    .tools::-webkit-scrollbar { display: none; }
    .tools > * { flex: none; }
    .tool { width: 34px; height: 34px; display: grid; place-items: center; padding: 0; color: var(--sky-text); background: none;
      border: 1px solid transparent; border-radius: var(--sky-radius-small); cursor: pointer; }
    .tool:hover { background: var(--sky-hover); }
    .tool[aria-pressed="true"] { background: var(--sky-selected); border-color: var(--sky-accent); }
    .tool svg { width: 20px; height: 20px; }
    .sep { width: 1px; height: 24px; margin: 0 4px; background: var(--sky-border); }
    .swatches { display: flex; gap: 4px; }
    .swatch { width: 24px; height: 24px; padding: 0; border: 2px solid var(--sky-surface); border-radius: 50%; box-shadow: 0 0 0 1px var(--sky-border); cursor: pointer; }
    .swatch[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--sky-accent); }
    .custom { position: relative; width: 28px; height: 28px; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 1px var(--sky-border);
      background: conic-gradient(#f44336, #ffeb3b, #4caf50, #00bcd4, #3f51b5, #e91e63, #f44336); }
    .custom input { position: absolute; inset: -6px; width: 40px; height: 40px; opacity: 0; cursor: pointer; }
    .size { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--sky-muted); }
    .size input { width: 90px; }
    .size output { min-width: 22px; text-align: right; font-variant-numeric: tabular-nums; }
    .stage { flex: 1; min-height: 0; display: grid; place-items: center; overflow: hidden; padding: 12px;
      background: repeating-conic-gradient(var(--sky-sunken) 0 25%, var(--sky-bg) 0 50%) 0 0 / 20px 20px; }
    canvas { max-width: 100%; max-height: 100%; background: transparent; box-shadow: 0 2px 12px rgba(0, 0, 0, .25); touch-action: none; cursor: crosshair; }
    .status { display: flex; gap: 12px; padding: 3px 10px; font-size: 12px; color: var(--sky-muted); background: var(--sky-surface); border-top: 1px solid var(--sky-border); white-space: nowrap; overflow: hidden; }
    .status .name { flex: 1; overflow: hidden; text-overflow: ellipsis; }
    /* phones: one row of tools that scrolls sideways, the picture keeps the rest of the screen */
    @media (max-width: 560px) { .tools { flex-wrap: nowrap; overflow-x: auto; } .size input { width: 70px; } .stage { padding: 6px; } }
  ]]></style>

  <body><![CDATA[
    <div class="tools" id="tools" role="toolbar"></div>
    <div class="stage" id="stage"><canvas id="canvas"></canvas></div>
    <div class="status"><span class="name" id="name"></span><span id="dims"></span></div>
  ]]></body>

  <script><![CDATA[(() => {
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    const tools = document.getElementById('tools');
    const t = (k, v) => sky.t(k, v);
    const MAX = 2400;             // pictures bigger than this are made smaller
    const COLOURS = ['#000000', '#ffffff', '#9e9e9e', '#e53935', '#fb8c00', '#fdd835', '#43a047', '#00acc1', '#1e88e5', '#5e35b1', '#d81b60', '#6d4c41'];
    const ICONS = {
      pencil: '<path d="M4 20l1-5L16 4l4 4L9 19z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
      brush: '<path d="M14 4l6 6-7 7-6-6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M7 13c-3 0-4 3-4 7 3 0 7-1 7-4" fill="currentColor"/>',
      eraser: '<path d="M3 15l9-9 8 8-6 6H8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 20h12M7.5 10.5l8 8" stroke="currentColor" stroke-width="2"/>',
      line: '<path d="M4 20L20 4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>',
      rect: '<rect x="4" y="6" width="16" height="12" rx="1" fill="none" stroke="currentColor" stroke-width="2"/>',
      ellipse: '<ellipse cx="12" cy="12" rx="9" ry="6.5" fill="none" stroke="currentColor" stroke-width="2"/>',
      fill: '<path d="M5 11l7-7 7 7-7 7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M5 11h14l-7 7z" fill="currentColor" opacity=".5"/><path d="M20 15c1 2 2 3 2 4a2 2 0 0 1-4 0c0-1 1-2 2-4z" fill="currentColor"/>',
      picker: '<path d="M14 4l6 6-2 2-6-6zM12 8l-7 7v4h4l7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
      filled: '<rect x="4" y="6" width="16" height="12" rx="1" fill="currentColor" opacity=".55" stroke="currentColor" stroke-width="2"/>',
      undo: '<path d="M9 14L4 9l5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 9h10a6 6 0 0 1 0 12h-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
      redo: '<path d="M15 14l5-5-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 9H10a6 6 0 0 0 0 12h3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
    };

    // what the app remembers (sky.data): the tool, the colour, the size, the shapes filled or not
    let prefs = { tool: 'brush', colour: '#1e88e5', size: 6, filled: false };
    let file = null;              // the picture opened or saved: { id, name, type, size, revision, editable }
    let dirty = false;
    const undo = [];
    const redo = [];
    let remembering = 0;
    const remember = () => { clearTimeout(remembering); remembering = setTimeout(() => sky.data.set(prefs, { force: true }), 400); };

    // ── the toolbar ────────────────────────────────────────────────────
    const button = (name, label, onClick) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'tool';
      b.title = label;
      b.setAttribute('aria-label', label);
      b.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true">${ICONS[name]}</svg>`;
      b.addEventListener('click', onClick);
      tools.append(b);
      return b;
    };
    const sep = () => tools.append(Object.assign(document.createElement('span'), { className: 'sep' }));
    const toolButtons = {};
    ['pencil', 'brush', 'eraser', 'line', 'rect', 'ellipse', 'fill', 'picker'].forEach((name) => {
      toolButtons[name] = button(name, t(name), () => { prefs.tool = name; show(); remember(); });
    });
    const filledButton = button('filled', t('filled'), () => { prefs.filled = !prefs.filled; show(); remember(); });
    sep();
    const swatches = document.createElement('div');
    swatches.className = 'swatches';
    swatches.setAttribute('aria-label', t('colour'));
    COLOURS.forEach((c) => {
      const s = document.createElement('button');
      s.type = 'button';
      s.className = 'swatch';
      s.style.background = c;
      s.dataset.colour = c;
      s.title = c;
      s.addEventListener('click', () => { prefs.colour = c; show(); remember(); });
      swatches.append(s);
    });
    tools.append(swatches);
    const custom = document.createElement('label');
    custom.className = 'custom';
    custom.title = t('more');
    custom.innerHTML = '<input type="color">';
    const customInput = custom.querySelector('input');
    customInput.addEventListener('input', () => { prefs.colour = customInput.value; show(); });
    customInput.addEventListener('change', remember);
    tools.append(custom);
    sep();
    const size = document.createElement('label');
    size.className = 'size';
    size.innerHTML = '<span></span><input type="range" min="1" max="60"><output></output>';
    size.querySelector('span').textContent = t('size');
    const sizeInput = size.querySelector('input');
    sizeInput.addEventListener('input', () => { prefs.size = Number(sizeInput.value); show(); });
    sizeInput.addEventListener('change', remember);
    tools.append(size);
    sep();
    const undoButton = button('undo', t('undo'), () => step(undo, redo));
    const redoButton = button('redo', t('redo'), () => step(redo, undo));

    function show() {
      Object.entries(toolButtons).forEach(([name, b]) => b.setAttribute('aria-pressed', String(prefs.tool === name)));
      filledButton.setAttribute('aria-pressed', String(prefs.filled));
      swatches.querySelectorAll('.swatch').forEach((s) => s.setAttribute('aria-pressed', String(s.dataset.colour === prefs.colour)));
      customInput.value = prefs.colour;
      sizeInput.value = prefs.size;
      size.querySelector('output').textContent = prefs.size;
      undoButton.disabled = !undo.length;
      redoButton.disabled = !redo.length;
      undoButton.style.opacity = undo.length ? 1 : 0.4;
      redoButton.style.opacity = redo.length ? 1 : 0.4;
      const name = file ? file.name : t('untitled');
      document.getElementById('name').textContent = (dirty ? '• ' : '') + name;
      document.getElementById('dims').textContent = `${canvas.width} × ${canvas.height}`;
      sky.ui.title((dirty ? '• ' : '') + name);
    }

    // ── the picture ────────────────────────────────────────────────────
    function blank(w, h) {
      canvas.width = w;
      canvas.height = h;
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, w, h);
    }
    function fresh() {
      const r = document.getElementById('stage').getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      blank(Math.round(Math.max(320, Math.min(1600, (r.width - 24) * dpr))), Math.round(Math.max(240, Math.min(1200, (r.height - 24) * dpr))));
      file = null;
      dirty = false;
      undo.length = 0;
      redo.length = 0;
      show();
    }
    const snapshot = () => ctx.getImageData(0, 0, canvas.width, canvas.height);
    function changed() {
      undo.push(snapshot());
      if (undo.length > 12) undo.shift(); // a few steps: a big picture takes a lot of memory
      redo.length = 0;
      dirty = true;
    }
    function step(from, to) {
      if (!from.length) return;
      to.push(snapshot());
      const img = from.pop();
      canvas.width = img.width;
      canvas.height = img.height;
      ctx.putImageData(img, 0, 0);
      dirty = true;
      show();
    }

    // ── drawing, with a mouse, a pen or a finger ───────────────────────
    const at = (e) => {
      const r = canvas.getBoundingClientRect();
      return { x: (e.clientX - r.left) * (canvas.width / r.width), y: (e.clientY - r.top) * (canvas.height / r.height) };
    };
    const scale = () => canvas.width / canvas.getBoundingClientRect().width;
    let drag = null;
    function stroke(from, to) {
      ctx.save();
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = prefs.colour;
      ctx.lineWidth = prefs.tool === 'pencil' ? Math.max(1, prefs.size / 3) * scale() : prefs.size * scale();
      if (prefs.tool === 'eraser') ctx.strokeStyle = '#ffffff'; // back to the white of the page, as on paper
      ctx.beginPath();
      ctx.moveTo(from.x, from.y);
      ctx.lineTo(to.x, to.y);
      ctx.stroke();
      ctx.restore();
    }
    function shape(a, b) {
      ctx.save();
      ctx.strokeStyle = prefs.colour;
      ctx.fillStyle = prefs.colour;
      ctx.lineWidth = prefs.size * scale();
      ctx.lineCap = 'round';
      ctx.beginPath();
      if (prefs.tool === 'line') { ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); }
      if (prefs.tool === 'rect') ctx.rect(Math.min(a.x, b.x), Math.min(a.y, b.y), Math.abs(b.x - a.x), Math.abs(b.y - a.y));
      if (prefs.tool === 'ellipse') ctx.ellipse((a.x + b.x) / 2, (a.y + b.y) / 2, Math.abs(b.x - a.x) / 2, Math.abs(b.y - a.y) / 2, 0, 0, Math.PI * 2);
      if (prefs.filled && prefs.tool !== 'line') ctx.fill(); else ctx.stroke();
      ctx.restore();
    }
    canvas.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      const p = at(e);
      if (prefs.tool === 'picker') {
        const d = ctx.getImageData(Math.floor(p.x), Math.floor(p.y), 1, 1).data;
        prefs.colour = '#' + [d[0], d[1], d[2]].map((n) => n.toString(16).padStart(2, '0')).join('');
        prefs.tool = 'brush';
        show();
        remember();
        return;
      }
      changed();
      if (prefs.tool === 'fill') { flood(p); show(); return; }
      try { canvas.setPointerCapture(e.pointerId); } catch { /* no capture: the stroke still follows inside the picture */ }
      drag = { start: p, last: p, before: ['line', 'rect', 'ellipse'].includes(prefs.tool) ? snapshot() : null };
      if (!drag.before) stroke(p, p);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const p = at(e);
      if (drag.before) { ctx.putImageData(drag.before, 0, 0); shape(drag.start, p); } else stroke(drag.last, p);
      drag.last = p;
    });
    const end = () => { if (drag) { drag = null; show(); } };
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);

    // the fill: every pixel of about the same colour, joined to the one touched
    function flood(p) {
      const w = canvas.width, h = canvas.height;
      const x0 = Math.floor(p.x), y0 = Math.floor(p.y);
      if (x0 < 0 || y0 < 0 || x0 >= w || y0 >= h) return;
      const img = ctx.getImageData(0, 0, w, h);
      const d = img.data;
      const i0 = (y0 * w + x0) * 4;
      const from = [d[i0], d[i0 + 1], d[i0 + 2], d[i0 + 3]];
      const to = [parseInt(prefs.colour.slice(1, 3), 16), parseInt(prefs.colour.slice(3, 5), 16), parseInt(prefs.colour.slice(5, 7), 16), 255];
      if (from.every((v, k) => Math.abs(v - to[k]) < 4)) return;
      const near = (i) => Math.abs(d[i] - from[0]) + Math.abs(d[i + 1] - from[1]) + Math.abs(d[i + 2] - from[2]) + Math.abs(d[i + 3] - from[3]) < 96;
      const seen = new Uint8Array(w * h);
      const stack = [x0, y0];
      while (stack.length) {
        const y = stack.pop(), x = stack.pop();
        let l = x;
        while (l > 0 && !seen[y * w + l - 1] && near((y * w + l - 1) * 4)) l--;
        let r = x;
        while (r < w - 1 && !seen[y * w + r + 1] && near((y * w + r + 1) * 4)) r++;
        for (let i = l; i <= r; i++) {
          const k = y * w + i;
          seen[k] = 1;
          d.set(to, k * 4);
          if (y > 0 && !seen[k - w] && near((k - w) * 4)) stack.push(i, y - 1);
          if (y < h - 1 && !seen[k + w] && near((k + w) * 4)) stack.push(i, y + 1);
        }
      }
      ctx.putImageData(img, 0, 0);
    }

    // ── files: only what the user gives, through Skypane's windows ─────
    async function load(given) {
      try {
        const blob = await sky.files.read(given);
        const picture = await createImageBitmap(blob);
        let w = picture.width, h = picture.height;
        const k = Math.min(1, MAX / Math.max(w, h));
        w = Math.round(w * k);
        h = Math.round(h * k);
        canvas.width = w;
        canvas.height = h;
        ctx.clearRect(0, 0, w, h);
        ctx.drawImage(picture, 0, 0, w, h);
        file = given;
        dirty = false;
        undo.length = 0;
        redo.length = 0;
        show();
        sky.ui.toast(k < 1 ? t('big', { w, h }) : t('opened', { name: given.name }));
      } catch (err) {
        sky.ui.toast(err.code === 'denied' ? err.message : t('notPicture'));
      }
    }
    const asBlob = (type) => new Promise((ok) => canvas.toBlob(ok, type, 0.92));
    const keeps = (type) => ['image/png', 'image/jpeg', 'image/webp'].includes(type);

    async function open() {
      if (dirty && !(await sky.ui.confirm(t('discard')))) return;
      const chosen = await sky.files.open({ types: ['image/*'] });
      if (chosen) load(chosen);
    }
    async function saveAs() {
      const type = file && keeps(file.type) ? file.type : 'image/png';
      const name = file ? file.name.replace(/\.[^.]+$/, '') + (type === 'image/png' ? '.png' : type === 'image/jpeg' ? '.jpg' : '.webp') : t('drawingName');
      const saved = await sky.files.saveAs(await asBlob(type), { name, types: ['image/*'] });
      if (!saved) return;
      file = saved;
      dirty = false;
      show();
      sky.ui.toast(t('saved', { name: saved.name }));
    }
    async function save() {
      if (!file || !keeps(file.type)) return saveAs();   // a new drawing, or a GIF/BMP Paint doesn't write
      if (!file.editable) { sky.ui.toast(t('readOnly')); return saveAs(); }
      const blob = await asBlob(file.type);
      try {
        file = await sky.files.write(file, blob);
      } catch (err) {
        if (err.code !== 'conflict' || !(await sky.ui.confirm(t('changed')))) { if (err.code !== 'conflict') sky.ui.toast(err.message); return; }
        file = await sky.files.write(file, blob, { force: true });
      }
      dirty = false;
      show();
      sky.ui.toast(t('saved', { name: file.name }));
    }

    sky.on('menu', async (action) => {
      if (action === 'new') { if (!dirty || await sky.ui.confirm(t('discard'))) fresh(); }
      if (action === 'open') open();
      if (action === 'save') save();
      if (action === 'saveAs') saveAs();
      if (action === 'undo') step(undo, redo);
      if (action === 'redo') step(redo, undo);
      if (action === 'clear') { changed(); ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, canvas.width, canvas.height); show(); }
    });

    // start: the remembered tools, then a blank page — or the picture the app was opened with (Files › Open with…)
    sky.data.get().then((saved) => { prefs = { ...prefs, ...(saved || {}) }; show(); }).catch(() => {});
    fresh();
    if (sky.launch.file) load(sky.launch.file);
  })();]]></script>
</sky-app>
